{
  "manifest_version": 3,
  "name": "Web Page Screenshot - Full Page & Snip Capture",
  "version": "1.1.4",
  "description": "Takes a full-page screenshot by automatically scrolling from top to bottom.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Take Full Page Screenshot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
